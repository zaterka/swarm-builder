# Python
__pycache__/
*.pyc
*.egg-info/
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Node
node_modules/

# Build output -- but NOT web/dist, which is committed on purpose.
#
# The server serves the canvas from web/dist and shows a "frontend has
# not been built yet" message when it is absent, so a clone that lacks it
# cannot render the UI without Node and pnpm. Shipping the built bundle
# is what makes `uv run swarm-builder` the entire quickstart: see
# scripts/check_dist.py for the staleness guard that keeps it honest, and
# README.md for the maintainer rebuild step.
dist/
!web/dist/
!web/dist/**

# Local caches and scratch state
.uv-cache/
.npm-cache/
.cache/
.pnpm-store/

# Local planning notes and the Group 0 spike: kept on disk, never published.
#
# These are working documents and oracle projects, not shipped code. The
# files stay in the working tree (the docs cite them as the local design
# record, and .dockerignore already excludes them from the image), but they
# are untracked so a clone receives only the app itself.
PLAN*.md
GROUP*_PLAN.md
TASK_PLAN_*.md
spike/

# Local editor and agent-tool state
.serena/
.claude/.headroom_wrap_settings.lock

# Runtime data: saved graphs and generated projects
workspace/

# Local environment (API keys); loaded by `swarm-builder` and docker compose
.env
