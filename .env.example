# ---------------------------------------------------------------------------
# Everything below is OPTIONAL.
#
# The normal way to configure a model is inside the app: open Swarm Builder,
# press "Model settings", choose a provider and paste your API key (there is a
# "Test connection" button), and optionally turn on Dry run mode to work with
# no credentials at all. That configuration lives in
# <workspace>/settings.json (owner-only, git-ignored) — not in this file — and
# it takes precedence over everything below.
#
# This file is the advanced path: for a machine that already has a harness
# configuration, for CI, or for a container. Nothing here is required.
# ---------------------------------------------------------------------------

# Where the app's own model settings live, when you want them somewhere other
# than <workspace>/settings.json.
SWARM_CONFIG=

# Where to look for settings.yaml to *inherit* model routes from an existing
# harness configuration. Absent entirely, or pointing at a folder with no
# settings.yaml, is a normal state: Swarm Builder falls back to SWARM_MODEL
# below, and never requires either.
DSH_HOME=~/.dsh

# Where saved graphs (workspace/graphs/*.json) and generated projects
# (workspace/projects/<graphId>/) live.
SWARM_WORKSPACE=./workspace

# Port the FastAPI server binds on 127.0.0.1.
PORT=8420

# uv's cache directory. ~/.cache/uv is not writable in every environment;
# pointing this at a project-local directory avoids a confusing failure
# that looks like a dependency problem (fact 10).
UV_CACHE_DIR=./.uv-cache

# Fallback model when nothing is configured in the app and no harness route is
# inherited. Either a PydanticAI known name (e.g.
# bedrock:us.anthropic.claude-opus-5, deepseek:deepseek-v4-flash) or, for a
# custom OpenAI-compatible endpoint, a bare model id paired with SWARM_BASE_URL
# below.
SWARM_MODEL=

# NOTE (not read here, but recognized by generated projects and the
# compile agent when SWARM_MODEL is a bare id rather than a known name):
#
#   SWARM_BASE_URL      custom OpenAI-compatible endpoint base URL
#   SWARM_API_KEY_ENV   name of the env var holding that endpoint's API
#                        key (the key value itself is never written to
#                        .env.example -- only the name of the variable
#                        to read it from at run time).

# Run feature (executes the compiled project with the credentials in this
# environment). SWARM_RUN_TEST_MODEL=1 makes the generated project's tracer
# use a keyless TestModel instead of the real model -- for exercising the
# Run plumbing without credentials, never for real output.
#
# Setting any of SWARM_FAKE_FILL / SWARM_FAKE_GENERATE / SWARM_RUN_TEST_MODEL
# also turns the in-app "Dry run mode" switch on and locks it: an offline or CI
# run must never silently spend real credentials.
SWARM_RUN_TEST_MODEL=

# Describe -> generate. SWARM_FAKE_GENERATE=1 replaces the model with a
# deterministic sentence-per-step draft, the model-free twin of
# SWARM_FAKE_FILL=1.
SWARM_FAKE_GENERATE=
