# Where to look for settings.yaml to inherit model routes (facts 3-4, 21-23).
# Absent entirely, or pointing at a folder with no settings.yaml, is a
# normal state: Swarm Builder falls back to SWARM_MODEL below.
DSH_HOME=~/.dsh

# Where saved graphs (workspace/graphs/*.json) and generated projects
# (workspace/projects/<graphId>/) live.
SWARM_WORKSPACE=./workspace

# Port the FastAPI server binds on 127.0.0.1.
PORT=8420

# uv's cache directory. ~/.cache/uv is not writable in every environment;
# pointing this at a project-local directory avoids a confusing failure
# that looks like a dependency problem (fact 10).
UV_CACHE_DIR=./.uv-cache

# Fallback model when no harness route is inherited (no DSH_HOME settings,
# or no agent-default-model section). Either a PydanticAI known name
# (e.g. bedrock:us.anthropic.claude-opus-5, deepseek:deepseek-v4-flash) or,
# for a custom OpenAI-compatible endpoint, a bare model id paired with
# SWARM_BASE_URL below.
SWARM_MODEL=

# NOTE (not read here, but recognized by generated projects and the
# compile agent when SWARM_MODEL is a bare id rather than a known name):
#
#   SWARM_BASE_URL      custom OpenAI-compatible endpoint base URL
#   SWARM_API_KEY_ENV   name of the env var holding that endpoint's API
#                        key (the key value itself is never written to
#                        .env.example -- only the name of the variable
#                        to read it from at run time).
